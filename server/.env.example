# Copy to .env (or a systemd EnvironmentFile) and fill in. NEVER commit the real
# values — .env is gitignored.

# Generate the two secret lines with:  python3 server/hash_password.py
AF_ADMIN_USERNAME=admin
AF_ADMIN_PASSWORD_HASH=
AF_SECRET_KEY=

# Where the SQLite database lives. Keep it OUTSIDE the repo in production.
AF_DB_PATH=/var/lib/adamfield/adamfield.db

# Path to the personal-website checkout nginx serves (for blog editing + builds).
AF_SITE_REPO=/var/www/personal-website

# Cookie is Secure by default (Cloudflare terminates TLS). Set to 0 only for
# local plain-http testing.
AF_COOKIE_SECURE=1

# Session lifetime in seconds (default 7 days).
AF_SESSION_TTL=604800

# Local dev only: also serve the static site from this app so everything is on
# one origin. Leave unset/0 in production (nginx serves static).
AF_SERVE_STATIC=0
